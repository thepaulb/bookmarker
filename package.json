{
  "name": "bookmarker",
  "private": true,
  "version": "0.1.0",
  "description": "Personal URL bookmarking service (a getpocket.com replacement)",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "dev": "concurrently \"nodemon server/index.js\" \"cd client && npm run dev\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "import": "node server/import-bookmarks.js",
    "import:pocket": "node server/import-bookmarks.js",
    "clean:urls": "node server/clean-urls.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run",
    "test:server:watch": "vitest",
    "test:server:coverage": "vitest run --coverage",
    "test:client": "cd client && npm test",
    "test:client:coverage": "cd client && npm run test:coverage"
  }
}
